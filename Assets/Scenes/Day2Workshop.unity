  m_Script: {fileID: 11500000, guid: d54946fbf6f9ef7448aab0bd43163c7f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Day2Controller
  day2SeaSceneName: Day2Sea
  menuSceneName: MainMenu
  interiorPage: {fileID: 486486236}
  benchPage: {fileID: 1702686208}
  screenFader: {fileID: 27748016}
  teddy: {fileID: 1702686206}
  subtitle: {fileID: 696156782}
  healthText: {fileID: 87285667}
  coinText: {fileID: 625830044}
  dialogue: {fileID: 657704848}
  elifLines:
  - Hello... Are you Grandpa Yusuf's grandchild? My grandma Hatice says you fixed
    her radio. This is Pamuk. I found him on the beach this morning, all tangled
    up in a net.
  - His arm came right off, his button eye fell out, and he's soaking wet inside.
    They told me to throw him away, but... Pamuk is my best friend. Can you make
    him better?
  thanksLines:
  - Pamuk! Is it really him? His arm is back... and look at his eye, it's blue like
    the sea!
  - What did you stuff him with? Plastic bottles? So the bottles we pulled out of
    the sea are inside Pamuk now? That's amazing!
  - "Grandma always says, \u2018Don't throw the old away, mend it.\u2019 Now I get
    it: everything we throw away ends up somewhere, and most of it ends up in the
    sea."
  - 'This is from my piggy bank, take it. Thank you so much! Today I''ll tell all
    my friends: don''t leave anything on the beach. A net caught Pamuk... it could
    catch a caretta too!'
  charsPerSecond: 55
  tellMoreButton: {fileID: 385613388}

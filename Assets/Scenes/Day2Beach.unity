  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedText
  key: "<b>On Hatice Teyze's radio tonight:</b> \u201CTo a turtle, a floating bag
    looks just like a jellyfish. Keep plastic out of the sea, neighbours!\u201D Not
    a single bag was left between the nests and the waves."
  turkishOnly: 0

  keySparkle: {fileID: 409133894}
  doorLeft: {fileID: 195599430}
  doorRight: {fileID: 1514687611}
  keyhole: {x: 1922, y: 1222}
  keyTipPivot: {x: 0.47, y: 0.05}
  firstCheck: {fileID: 129581751}
  doneBadge: {fileID: 119268155}
  firstTitle: {fileID: 488818837}
  firstSubtitle: {fileID: 803555407}
  firstStrike: {fileID: 217500783}
  startDayButton: {fileID: 695427283}
  dialogue: {fileID: 1150625603}
  dialogueLines:
  - "Good morning, dear! So Yusuf\u2019s workshop is open again. I brought you something...\nThis
    was my husband\u2019s radio. We listened to the fishing news on it every evening."
  - 'It went quiet last winter. The dial glass cracked and a wire came loose inside.

    Yusuf
    always said nothing is too old to be fixed. Will you try?'
  headOutLine: Before you head out, dear... would you take a look at my radio?
  charsPerSecond: 55
  tellMoreButton: {fileID: 1157065514}
  letsFixButton: {fileID: 1011146341}
  tasksButtonActive: {fileID: 753552510}
  tasksPanel: {fileID: 1153197491}
  panelSlide: 860
  taskCount: {fileID: 557090069}
  taskBadge: {fileID: 1250314661}
  meetCheck: {fileID: 12282454}
  meetStrike: {fileID: 1963098295}
  meetFade: {fileID: 566078718}
  meetStrikeWidth: 300
  repairCheck: {fileID: 2086065187}
  repairStrike: {fileID: 181395580}
  repairFade: {fileID: 1639361456}
  repairStrikeWidth: 266
  repair: {fileID: 708763925}
  thanksLine: 'It''s singing again, just like the old days! Thank you, dear. Yusuf
    would be so proud.

    Now go on, the beach is waiting. Head out whenever you''re
    ready.'
  tasksTotal: 5
